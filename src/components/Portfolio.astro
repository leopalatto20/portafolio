---
import '../styles/global.css';
import {projects, copy, contact, type Locale} from '../data/portfolio';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const t = copy[locale];
const base = locale === 'es' ? '/es/' : '/';
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={t.description} />
  <meta name="theme-color" content="#f1f0e8" />
  <title>{locale === 'es' ? 'Leonardo Pérez Palatto — Software y Ciberseguridad' : 'Leonardo Pérez Palatto — Software & Cybersecurity'}</title>
  <meta property="og:title" content="Leonardo Pérez Palatto" /><meta property="og:description" content={t.description} /><meta property="og:type" content="website" /><meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'} />
  <link rel="alternate" hreflang="en" href="/" /><link rel="alternate" hreflang="es" href="/es/" /><link rel="alternate" hreflang="x-default" href="/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/BarlowCondensed-Bold.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body id="top">
<a class="skip-link" href="#work">{t.skip}</a>
<header class="masthead">
  <a class="identity" href={base} aria-label={t.home}><strong>Leonardo Pérez Palatto</strong><span>{t.focus}</span></a>
  <nav aria-label={t.navigation}>
    <a href="#work">{t.work}</a><a href="#experience">{t.experience}</a>
    <a class="cv-link" href={contact.cv} download="CV_LeonardoPerez.pdf">{t.download}</a>
    <a class="contact-link" href="#contact">{t.contact}<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
    <span class="languages" aria-label={t.language}><a href="/" lang="en" hreflang="en" aria-label="English" aria-current={locale === 'en' ? 'page' : undefined} data-locale="en">EN</a><span aria-hidden="true">/</span><a href="/es/" lang="es" hreflang="es" aria-label="Español" aria-current={locale === 'es' ? 'page' : undefined} data-locale="es">ES</a></span>
  </nav>
</header>
<main>
  <section class="opening"><h1>{t.headline}</h1><p>{t.intro}</p></section>
  <section id="work" class="work" aria-labelledby="work-title">
    <div class="section-label"><h2 id="work-title">{t.selected}</h2><span>2024–2026</span></div>
    <div class="project-list">
    {projects.map((project, index) => {
      const p = project[locale];
      return <details class:list={['project', {'featured': index === 0}]} id={project.id} open={index === 0}>
        <summary>
          <span class="project-date"><span class="project-number">{String(index+1).padStart(2,'0')}</span><span class="date">{p.date}</span>{p.status && <span class="status">{p.status}</span>}</span>
          <span class="project-name"><h3>{project.name}</h3>{p.collaborator && <span class="collaborator">{p.collaborator}</span>}</span>
          <span class="project-summary">{p.summary}</span>
          <span class="project-domain">{p.domain}</span>
          <span class="disclosure"><span class="when-closed">{t.expand}<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><path d="M2 8h12M8 2v12" /></svg></span><span class="when-open">{t.close}<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><path d="M2 8h12" /></svg></span></span>
        </summary>
        {index === 0 ? <>
          <div class="featured-body"><h4>{t.how}</h4><div class="mechanism"><img src="/assets/plates/mechanism.png" alt="" width="2172" height="302" /><ol>{p.steps.map(([title, text]) => <li><strong>{title}</strong><span>{text}</span></li>)}</ol></div></div>
          <details class="project-notes"><summary>{t.projectNotes}<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16"><path d="m3 6 5 5 5-5" /></svg></summary><div class="project-copy"><div><h4>{t.problem}</h4><p>{p.problem}</p></div><div><h4>{t.contribution}</h4><p>{p.work}</p></div><div><h4>{t.result}</h4><p>{p.result}</p><a class="permalink" href={'#'+project.id} aria-label={t.projectLink+' '+project.name}>{t.projectLink}</a></div></div></details>
        </> : <div class="project-body">
          <div class="project-body-heading"><a class="permalink" href={'#'+project.id} aria-label={t.projectLink+' '+project.name}>{t.projectLink}</a></div>
          <div class="project-copy"><div><h4>{t.problem}</h4><p>{p.problem}</p></div><div><h4>{t.contribution}</h4><p>{p.work}</p></div><div><h4>{t.result}</h4><p>{p.result}</p></div></div>
          <h4 class="flow-heading">{t.how}</h4><ol class="project-flow">{p.steps.map(([title,text])=><li><strong>{title}</strong><span>{text}</span></li>)}</ol>
        </div>}
      </details>;
    })}
    </div>
  </section>
  <section id="experience" class="experience" aria-labelledby="experience-title">
    <div class="section-heading"><h2 id="experience-title">{t.experienceTitle}</h2><a class="text-link" href={'mailto:'+contact.email}>{contact.email}<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M5 19 19 5M5 5h14v14" /></svg></a></div>
    {t.jobs.map(job=><article class="job"><div class="experience-entry"><h3>{job.company}</h3><p>{job.role}</p><span class="date">{job.date}</span></div><ul>{job.items.map(item=><li>{item}</li>)}</ul></article>)}
  </section>
  <section id="education" class="education" aria-labelledby="education-title">
    <h2 id="education-title">{t.educationTitle}</h2>
    <div class="education-layout"><div class="degree"><h3>{t.degree}</h3><p class="degree-focus">{t.degreeFocus}</p><p>{t.school}<br />{t.campus}</p><p class="date">{t.educationDate}</p><h4>{t.coursework}</h4><p>{t.courses}</p></div>
      <div class="knowledge"><h3>{t.knowledge}</h3><p>{t.knowledgeIntro}</p><dl>{t.groups.map(group=><div><dt>{group.title}</dt><dd><p>{group.description}</p><span>{group.tools.join(' / ')}</span></dd></div>)}</dl><div class="working-languages"><h4>{t.languages}</h4><p>{t.languageDetails}</p></div><h4>{t.approachTitle}</h4><p>{t.approach}</p></div>
    </div>
  </section>
  <section id="contact" class="contact" aria-labelledby="contact-title"><div><h2 id="contact-title">{t.contactTitle}</h2><p>{t.contactText}</p></div><div class="contact-actions"><a class="email-action" href={'mailto:'+contact.email}>{contact.email}<svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28"><path d="M5 19 19 5M5 5h14v14" /></svg></a><div class="contact-links"><a href={contact.cv} download="CV_LeonardoPerez.pdf">{t.download}<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 3v13m-5-5 5 5 5-5M4 17v4h16v-4" /></svg></a><a href={contact.linkedin}>LinkedIn</a><a href={contact.github}>GitHub</a></div></div></section>
</main>
<footer><span>Leonardo Pérez Palatto</span><a href="#top">{t.back}<svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 20V4m-6 6 6-6 6 6" /></svg></a></footer>
<script>
  import { enhanceProjectMotion } from '../scripts/project-motion';
  const motion = enhanceProjectMotion();
  const projectDetails = [...document.querySelectorAll<HTMLDetailsElement>('details.project')];
  const localeLinks = [...document.querySelectorAll<HTMLAnchorElement>('a[data-locale]')];
  const updateLocaleLinks = () => {
    const open = projectDetails.filter(project=>motion.isExpanded(project)).map(project=>project.id);
    const hash = location.hash;
    for (const link of localeLinks) {
      const url = new URL(link.dataset.locale === 'es' ? '/es/' : '/',location.origin);
      url.searchParams.set('open',open.length ? open.join(',') : 'none');
      url.hash = hash;
      link.href = url.pathname + url.search + url.hash;
    }
  };
  const openAnchor = () => {
    let id = '';
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const project = projectDetails.find(project=>project.id===id);
    if(project) { motion.open(project); requestAnimationFrame(()=>project.scrollIntoView({block:'start'})); }
    updateLocaleLinks();
  };
  const saved = new URLSearchParams(location.search).get('open');
  if(saved !== null) {
    const ids = saved.split(',');
    for(const project of projectDetails) project.open=ids.includes(project.id);
  }
  for(const project of projectDetails) project.addEventListener('toggle',updateLocaleLinks);
  for(const project of projectDetails) project.querySelector(':scope > summary')?.addEventListener('click',()=>queueMicrotask(updateLocaleLinks));
  window.addEventListener('hashchange',openAnchor);
  for(const link of localeLinks) link.addEventListener('click',()=>{
    const currentProject=projectDetails.find(project=>{const rect=project.getBoundingClientRect();return rect.top<=80&&rect.bottom>80;});
    const currentSection=[...document.querySelectorAll<HTMLElement>('main > section')].reverse().find(section=>section.getBoundingClientRect().top<=80);
    const url=new URL(link.href);
    url.hash=currentProject?.id || currentSection?.id || location.hash;
    link.href=url.pathname+url.search+url.hash;
  });
  openAnchor();
</script>
</body>
</html>
